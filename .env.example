# --- Mahalla server sozlamalari ---
# PostgreSQL manzili. Bo'sh qoldirilsa, lokal sinov uchun ichki baza ishga tushadi (.data/pg).
DATABASE_URL=postgres://mahalla:mahalla@localhost:5432/mahalla
PORT=3000
NODE_ENV=production

# Telegram orqali kirish: @BotFather'da bot yarating, /setdomain bilan saytingiz domenini bog'lang.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Faqat lokal sinov uchun: nik bilan parolsiz kirish. Production'da 0 bo'lishi SHART.
DEV_LOGIN=0

# Bo'sh shahar ko'rinmasligi uchun 24 ta namuna qo'shni va ~630 bino qo'shish (bir marta).
SEED_DEMO=1

# O'yin kuni uzunligi (soniya). 86400 = haqiqiy kun. Sinov uchun 360 (6 daqiqa).
DAY_SECONDS=86400

SESSION_DAYS=30
RATE_LIMIT_PER_MINUTE=120
